# Copy to `.env` (or paste these as Portainer stack environment variables — never commit the real .env).
#
# TLS + wildcard subdomain routing is handled by CloudFront, not this stack —
# there's no domain/cert config here. CloudFront originates to this EC2 box
# over plain HTTP on port 8080.

# Database — a free-tier RDS PostgreSQL instance (db.t3.micro/db.t4g.micro, 20GB, Single-AZ)
DB_URL=jdbc:postgresql://your-rds-endpoint.ap-south-1.rds.amazonaws.com:5432/msmeerp
DB_USER=msmeerp
DB_PASSWORD=change-me-to-a-strong-password

# Auth
JWT_SECRET=generate-a-long-random-string-min-32-bytes

# AWS SES (same credentials/region already used for onboarding emails)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
MAIL_ENABLED=true
MAIL_FROM=info@yourdomain.com

# Multi-tenant portal domain (must match your real domain; used to build portal URLs in emails)
PORTAL_BASE_DOMAIN=yourdomain.com

# Wildcard pattern covering every tenant subdomain (CloudFront makes tenant traffic
# same-origin so this mostly matters for direct/local access to the API)
CORS_ALLOWED_ORIGINS=https://*.yourdomain.com

# Image to deploy (built by CI, pushed to Docker Hub — see .github/workflows/deploy.yml)
BACKEND_IMAGE=msmeerpportal/msme-erp-backend:latest

# Purely informational — update these by hand in Portainer after each release
# so you can see at a glance which versions are live.
BACKEND_VERSION=
FRONTEND_VERSION=
